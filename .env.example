# Database - Local Development (SQLite file)
DATABASE_URL="file:./prisma/dev.db"

# Database - Turso Cloud (for production/Vercel)
# Get these from https://turso.tech after creating a database
# TURSO_DATABASE_URL="libsql://your-db-name-your-username.turso.io"
# TURSO_AUTH_TOKEN="your-auth-token-from-turso"

# JWT Secret - CHANGE THIS IN PRODUCTION
# Generate a secure random string: openssl rand -base64 32
JWT_SECRET="your-super-secret-jwt-key-change-in-production"

# App URL (for auth callbacks)
NEXT_PUBLIC_APP_URL="http://localhost:3000"
